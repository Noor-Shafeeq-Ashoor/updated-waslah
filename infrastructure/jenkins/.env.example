# Copy to infrastructure/jenkins/.env (ignored by Git). Restart Jenkins after changes:
#   docker compose up -d --force-recreate
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# Your repository (https). For a private repository also set GITHUB_USER and GITHUB_TOKEN
# (a fine-grained token with read access to Contents).
GIT_REPO_URL=https://github.com/<user>/<repo>.git
GITHUB_USER=
GITHUB_TOKEN=

# Printed by infrastructure/aws/setup.sh (IAM user waslah-jenkins)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
EC2_INSTANCE_ID=
DEPLOY_BUCKET=
