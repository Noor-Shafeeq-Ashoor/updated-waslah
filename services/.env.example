# Database
DB_URL=jdbc:postgresql://postgres:5432/waslah
DB_USERNAME=postgres
DB_PASSWORD=replace-with-database-password

# JWT Security
JWT_SECRET=replace-with-secure-jwt-secret
INTERNAL_TOKEN=replace-with-secure-internal-token

# Microservices
IDENTITY_URL=http://identity-service:8081
CAREER_URL=http://career-service:8082
WORKSPACE_URL=http://workspace-service:8083
NOTIFICATION_URL=http://notification-service:8084

# Email
MAIL_USERNAME=replace-with-email
MAIL_APP_PASSWORD=replace-with-email-app-password

# Frontend
APP_BASE_URL=http://localhost

# Admin
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@waslah.com
ADMIN_PASSWORD=replace-with-secure-admin-password
